# Copia este archivo a .env.local y completa tu API key para activar noticias en vivo.
# Sin esta variable, EconoRadar sigue funcionando normalmente con datos locales curados.

# API key de https://newsapi.org (plan gratuito disponible)
VITE_NEWS_API_KEY=

# Opcional: solo si usas un proxy propio en vez de newsapi.org directamente
# VITE_NEWS_API_BASE_URL=https://newsapi.org/v2
