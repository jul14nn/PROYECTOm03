generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SongStage {
  IDEA
  PREPRODUCCION
  ESCRITURA
  GRABACION
  MEZCLA
  MASTER
  PORTADA
  DISTRIBUCION
  LANZADA
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  HECHO
}

enum InviteStatus {
  PENDIENTE
  ENVIADA
  ACEPTADA
  RECHAZADA
}

// ---------------------------------------------------------------------------
// Autenticación (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  songs    Song[]
  contacts Contact[]
  events   CalendarEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Core catalog
// ---------------------------------------------------------------------------

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  role      String? // productor, featuring, mánager, distribuidora, etc.
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  featurings     SongFeaturing[]
  producedSongs  SongProducer[]
  royalties      Royalty[]
  eventInvites   EventInvite[]
}

model Song {
  id            String    @id @default(cuid())
  userId        String
  title         String
  genre         String? // tipo de canción
  color         String    @default("#6366f1")
  stage         SongStage @default(IDEA)
  needsCover    Boolean   @default(true)
  coverUrl      String?
  bpm           Int?
  key           String?
  notes         String?
  releaseDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  featurings       SongFeaturing[]
  producers        SongProducer[]
  videoIdeas       VideoIdea[]
  tasks            PreProductionTask[]
  distributionSteps DistributionStep[]
  marketingBudgets MarketingBudgetItem[]
  marketingIdeas   MarketingIdea[]
  royalties        Royalty[]
  events           CalendarEvent[]
}

model SongFeaturing {
  id        String   @id @default(cuid())
  songId    String
  contactId String?
  artistName String
  role      String? // voz, rap, coros...
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  song    Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

model SongProducer {
  id        String   @id @default(cuid())
  songId    String
  contactId String
  role      String? // productor, mezcla, máster, beatmaker
  createdAt DateTime @default(now())

  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model VideoIdea {
  id          String   @id @default(cuid())
  songId      String
  title       String
  description String?
  referenceUrl String?
  status      TaskStatus @default(PENDIENTE)
  createdAt   DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model PreProductionTask {
  id        String     @id @default(cuid())
  songId    String
  title     String
  status    TaskStatus @default(PENDIENTE)
  dueDate   DateTime?
  assignee  String?
  createdAt DateTime   @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model DistributionStep {
  id          String     @id @default(cuid())
  songId      String
  distributor String // ej. DistroKid, Spotify for Artists...
  step        String // ej. "Enviar metadata", "Aprobar portada"
  status      TaskStatus @default(PENDIENTE)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime   @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model MarketingBudgetItem {
  id            String   @id @default(cuid())
  songId        String
  category      String // ads, contenido, PR, playlisting...
  plannedAmount Float    @default(0)
  actualAmount  Float    @default(0)
  currency      String   @default("EUR")
  notes         String?
  createdAt     DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model MarketingIdea {
  id          String     @id @default(cuid())
  songId      String
  title       String
  description String?
  channel     String? // TikTok, Instagram, YouTube...
  status      TaskStatus @default(PENDIENTE)
  createdAt   DateTime   @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model Royalty {
  id          String   @id @default(cuid())
  songId      String
  contactId   String?
  name        String
  role        String? // autor, productor, featuring, sello...
  percentage  Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  song     Song              @relation(fields: [songId], references: [id], onDelete: Cascade)
  contact  Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  payments RoyaltyPayment[]
}

model RoyaltyPayment {
  id        String   @id @default(cuid())
  royaltyId String
  amount    Float
  currency  String   @default("EUR")
  date      DateTime @default(now())
  notes     String?

  royalty Royalty @relation(fields: [royaltyId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  songId      String?
  createdAt   DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  song    Song?         @relation(fields: [songId], references: [id], onDelete: SetNull)
  invites EventInvite[]
}

model EventInvite {
  id        String       @id @default(cuid())
  eventId   String
  contactId String?
  email     String
  status    InviteStatus @default(PENDIENTE)
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
}
